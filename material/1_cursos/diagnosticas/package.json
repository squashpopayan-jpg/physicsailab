{
  "name": "diagnosticas",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "node build.js",
    "test:banco": "node tests/banco.test.js",
    "test:analisis": "node tests/analisis.test.js",
    "test:reglas": "firebase emulators:exec --only database --project demo-diagnosticas \"node tests/reglas.test.js\"",
    "emuladores": "firebase emulators:start --project demo-diagnosticas",
    "semilla": "node tools/semilla.js",
    "dev": "node tools/dev.js",
    "simular": "node tools/simular-vivo.js",
    "test": "node tests/banco.test.js && node tests/analisis.test.js && npm run test:reglas",
    "desplegar": "node build.js && firebase deploy --only hosting,database"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Pruebas diagnósticas para colegios y universidades",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1"
  },
  "private": true
}